# Required: API key for DeepSeek (from platform.deepseek.com) or from polza.ai
DEEPSEEK_API_KEY=

# Optional: leave empty for the official DeepSeek API.
# If you pay through polza.ai (Russian cards, SBP), set: https://polza.ai/api/v1
DEEPSEEK_BASE_URL=

# Optional: model name. Default is deepseek-flash (official API)
# or deepseek/deepseek-v4.1-flash (polza.ai)
DEEPSEEK_MODEL=

# Optional: enables internet search; without it regular answers still work
SERPER_API_KEY=
